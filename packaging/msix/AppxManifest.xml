<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for the Microsoft Store. build.ps1 replaces the
  $TOKENS$; the identity values come from Partner Center (Product identity).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 desktop6 rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCH$" />

  <Properties>
    <!-- Must match the name reserved in Partner Center. The Start menu entry
         (VisualElements below) keeps the short name. -->
    <DisplayName>Tessera Window Manager</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- %APPDATA%\Tessera and %LOCALAPPDATA%\Tessera stay real folders: the
         configuration is edited by hand in other programs, is shared with the
         zip version and survives a reinstall. Needs unvirtualizedResources. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- One application only: the Store rejects a second one without a Start
         menu entry (a "headless app"), so the command line
         is an alias of this one. SupportsMultipleInstances is required by
         the console alias; Tessera itself stays single-instance (mutex). -->
    <Application Id="Tessera" Executable="tessera.exe" EntryPoint="Windows.FullTrustApplication"
                 desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Tessera"
        Description="Window tiling manager: zones and auto-tiling for Windows 11"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- TaskId must match TASK_ID in crates/tessera-win/src/autostart.rs. -->
        <desktop:Extension Category="windows.startupTask" Executable="tessera.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TesseraStartup" Enabled="false" DisplayName="Tessera" />
        </desktop:Extension>
        <!-- Command line: runs tesserac.exe in the calling terminal. Only one
             alias extension is allowed per application, so tessera.exe has none
             (its editor and shortcuts window are in the tray menu). -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="tesserac.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="tesserac.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
